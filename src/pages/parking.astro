---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { REGION_CENTERS } from '../utils/parking';

const naverClientId = import.meta.env.PUBLIC_NAVER_MAP_CLIENT_ID;
const pageTitle = '전국 무료주차장 검색 | 더트립가이드';
const pageDescription = '전국 무료주차장, 공영주차장 위치와 운영정보를 한눈에 검색하세요. 지역명으로 간편하게 주차장을 찾을 수 있습니다.';
const pageUrl = 'https://thetripguide.xyz/parking/';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
>
  <Fragment slot="head" set:html={`<script src="https://oapi.map.naver.com/openapi/v3/maps.js?ncpKeyId=${naverClientId}"></script>`} />
  <Header />

  <div class="max-w-3xl mx-auto">
    <!-- 페이지 제목 -->
    <div class="mb-8 text-center">
      <h1 class="text-4xl font-black text-gray-900 mb-3">전국 무료주차장 검색</h1>
      <p class="text-gray-500 text-lg">지역명을 입력하면 무료주차장, 공영주차장 정보를 확인할 수 있습니다</p>
    </div>

    <!-- 검색 폼 -->
    <div class="mb-6">
      <div class="flex gap-3">
        <input
          id="search-input"
          type="text"
          placeholder="지역명을 입력하세요 (예: 서울, 부산, 제주)"
          class="flex-1 px-4 py-3 border-2 border-gray-200 rounded-xl text-base focus:outline-none focus:border-emerald-500 transition-colors"
        />
        <button
          id="search-btn"
          class="px-6 py-3 bg-emerald-600 text-white font-semibold rounded-xl hover:bg-emerald-700 transition-colors shrink-0"
        >
          검색
        </button>
      </div>

      <!-- 빠른 검색 태그 -->
      <div class="flex flex-wrap gap-2 mt-3">
        {['서울', '부산', '제주', '강릉', '인천'].map((region) => (
          <button
            class="quick-search-tag px-3 py-1.5 text-sm bg-gray-100 text-gray-600 rounded-full hover:bg-emerald-50 hover:text-emerald-600 transition-colors"
            data-region={region}
          >
            {region}
          </button>
        ))}
      </div>
    </div>

    <!-- 필터 탭 -->
    <div class="flex gap-2 mb-6" id="filter-tabs">
      <button
        class="filter-tab px-4 py-2 text-sm font-semibold rounded-lg bg-emerald-600 text-white"
        data-filter="all"
      >
        전체
      </button>
      <button
        class="filter-tab px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200"
        data-filter="free"
      >
        무료주차장
      </button>
      <button
        class="filter-tab px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200"
        data-filter="public"
      >
        공영주차장
      </button>
    </div>

    <!-- 네이버 지도 -->
    <div class="mb-6 rounded-2xl overflow-hidden border border-gray-200 shadow-sm">
      <div id="naver-map" class="w-full h-[400px] bg-gray-100 flex items-center justify-center">
        <p class="text-gray-400 text-sm" id="map-placeholder">지역을 검색하면 지도에 주차장 위치가 표시됩니다</p>
      </div>
    </div>

    <!-- 로딩 표시 -->
    <div id="loading-state" class="hidden text-center py-8">
      <div class="inline-block w-8 h-8 border-4 border-emerald-200 border-t-emerald-600 rounded-full animate-spin"></div>
      <p class="text-gray-500 mt-3">주차장 정보를 검색하고 있습니다...</p>
    </div>

    <!-- 검색 결과 -->
    <div id="results-section" class="hidden">
      <p class="text-sm text-gray-500 mb-4">
        검색 결과: <span id="results-count" class="font-semibold text-gray-900">0</span>건
        <span id="total-count" class="text-gray-400"></span>
      </p>

      <div id="results-list" class="flex flex-col gap-4 mb-12">
        <!-- 결과 카드가 여기에 동적으로 삽입됩니다 -->
      </div>

      <!-- 더보기 버튼 -->
      <div id="load-more-wrapper" class="hidden text-center mb-12">
        <button
          id="load-more-btn"
          class="px-8 py-3 bg-gray-100 text-gray-700 font-semibold rounded-xl hover:bg-gray-200 transition-colors"
        >
          더보기
        </button>
      </div>
    </div>

    <!-- 에러 표시 -->
    <div id="error-state" class="hidden text-center py-12">
      <div class="text-5xl mb-4">&#x26A0;&#xFE0F;</div>
      <p id="error-message" class="text-gray-500 text-lg">오류가 발생했습니다</p>
      <p class="text-gray-300 text-sm mt-2">잠시 후 다시 시도해주세요</p>
    </div>

    <!-- 검색 전 안내 -->
    <div id="empty-state" class="text-center py-12">
      <div class="text-6xl mb-4">&#x1F17F;&#xFE0F;</div>
      <p class="text-gray-400 text-lg">위의 검색창에서 지역명을 검색해보세요</p>
      <p class="text-gray-300 text-sm mt-2">전국 무료주차장, 공영주차장 정보를 제공합니다</p>
    </div>

    <!-- 데이터 출처 안내 -->
    <div class="mt-8 mb-4 p-4 bg-gray-50 rounded-xl text-xs text-gray-400 text-center">
      <p>데이터 출처: 공공데이터포털 (data.go.kr) - 전국주차장정보 표준데이터</p>
      <p class="mt-1">실제 운영 상황과 다를 수 있으니 방문 전 확인 바랍니다</p>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ regionCenters: REGION_CENTERS }}>
  // 전역 상태
  let map = null;
  let markers = [];
  let infoWindows = [];
  let currentFilter = 'all';
  let currentPage = 1;
  let currentQuery = '';
  let totalCount = 0;
  let allResults = [];
  let mapInitialized = false;

  // DOM 요소
  const searchInput = document.getElementById('search-input');
  const searchBtn = document.getElementById('search-btn');
  const filterTabs = document.querySelectorAll('.filter-tab');
  const quickSearchTags = document.querySelectorAll('.quick-search-tag');
  const resultsSection = document.getElementById('results-section');
  const resultsList = document.getElementById('results-list');
  const resultsCount = document.getElementById('results-count');
  const totalCountEl = document.getElementById('total-count');
  const emptyState = document.getElementById('empty-state');
  const loadingState = document.getElementById('loading-state');
  const errorState = document.getElementById('error-state');
  const errorMessage = document.getElementById('error-message');
  const mapPlaceholder = document.getElementById('map-placeholder');
  const loadMoreWrapper = document.getElementById('load-more-wrapper');
  const loadMoreBtn = document.getElementById('load-more-btn');

  // 네이버 지도 초기화
  function initMap(centerLat, centerLng) {
    if (typeof naver === 'undefined' || !naver.maps) {
      const mapEl = document.getElementById('naver-map');
      mapEl.innerHTML = '<div class="flex items-center justify-center h-full text-gray-400 text-sm px-4 text-center"><p>네이버맵 API 키 설정 후 지도가 표시됩니다</p></div>';
      return;
    }

    const mapOptions = {
      center: new naver.maps.LatLng(centerLat || 37.5665, centerLng || 126.9780),
      zoom: 13,
      mapTypeControl: false,
      scaleControl: true,
      zoomControl: true,
      zoomControlOptions: {
        position: naver.maps.Position.TOP_RIGHT,
      },
    };

    map = new naver.maps.Map('naver-map', mapOptions);
    mapInitialized = true;
    if (mapPlaceholder) mapPlaceholder.style.display = 'none';
  }

  // 마커 모두 제거
  function clearMarkers() {
    markers.forEach((marker) => marker.setMap(null));
    infoWindows.forEach((iw) => iw.close());
    markers = [];
    infoWindows = [];
  }

  // 검색 결과에 마커 추가
  function addMarkers(results) {
    if (!mapInitialized || !map) return;

    clearMarkers();

    const bounds = new naver.maps.LatLngBounds();

    results.forEach((lot, index) => {
      if (!lot.lat || !lot.lng) return;

      const position = new naver.maps.LatLng(lot.lat, lot.lng);
      bounds.extend(position);

      const marker = new naver.maps.Marker({
        map: map,
        position: position,
        title: lot.name,
        icon: {
          content: '<div style="\
            background: ' + (lot.isFree ? '#059669' : '#3b82f6') + ';\
            color: white;\
            padding: 4px 8px;\
            border-radius: 12px;\
            font-size: 11px;\
            font-weight: 700;\
            white-space: nowrap;\
            box-shadow: 0 2px 6px rgba(0,0,0,0.2);\
            border: 2px solid white;\
          ">' + (lot.isFree ? '무료' : '공영') + '</div>',
          anchor: new naver.maps.Point(20, 20),
        },
      });

      const infoWindow = new naver.maps.InfoWindow({
        content: '\
          <div style="padding:14px 16px;min-width:220px;max-width:280px;line-height:1.5;">\
            <p style="font-weight:800;font-size:15px;margin:0 0 6px 0;color:#111;">' + lot.name + '</p>\
            <p style="font-size:12px;color:#666;margin:0 0 4px 0;">' + lot.address + '</p>\
            <div style="display:flex;gap:8px;margin-top:8px;font-size:12px;">\
              <span style="\
                background:' + (lot.isFree ? '#ecfdf5' : '#eff6ff') + ';\
                color:' + (lot.isFree ? '#059669' : '#3b82f6') + ';\
                padding:2px 8px;\
                border-radius:6px;\
                font-weight:600;\
              ">' + (lot.isFree ? '무료' : lot.feeInfo) + '</span>\
              <span style="color:#999;">' + lot.totalSpaces + '면</span>\
            </div>\
            <p style="font-size:11px;color:#999;margin:6px 0 0 0;">\
              ' + lot.weekdayOpen + '~' + lot.weekdayClose + ' | ' + (lot.phone || '-') + '\
            </p>\
          </div>\
        ',
        borderWidth: 0,
        backgroundColor: 'white',
        anchorSize: new naver.maps.Size(10, 10),
        pixelOffset: new naver.maps.Point(0, -4),
      });

      naver.maps.Event.addListener(marker, 'click', function() {
        infoWindows.forEach(function(iw) { iw.close(); });
        infoWindow.open(map, marker);
      });

      markers.push(marker);
      infoWindows.push(infoWindow);
    });

    if (results.length > 0) {
      map.fitBounds(bounds, { top: 60, right: 60, bottom: 60, left: 60 });
    }
  }

  // UI 상태 관리
  function showLoading() {
    loadingState.classList.remove('hidden');
    resultsSection.classList.add('hidden');
    emptyState.classList.add('hidden');
    errorState.classList.add('hidden');
  }

  function hideLoading() {
    loadingState.classList.add('hidden');
  }

  function showError(msg) {
    hideLoading();
    errorState.classList.remove('hidden');
    resultsSection.classList.add('hidden');
    emptyState.classList.add('hidden');
    errorMessage.textContent = msg;
  }

  // 공공데이터 API 호출 (서버 API 라우트 경유)
  async function fetchParking(region, filter, page) {
    const params = new URLSearchParams({
      region: region,
      filter: filter,
      page: String(page),
      size: '50',
    });

    const res = await fetch('/api/parking/?' + params.toString());
    const data = await res.json();

    if (!res.ok || data.error) {
      throw new Error(data.error || '서버 오류가 발생했습니다.');
    }

    return data;
  }

  // 검색 실행
  async function performSearch(isLoadMore) {
    const query = searchInput.value.trim();
    if (!query) return;

    if (!isLoadMore) {
      currentPage = 1;
      currentQuery = query;
      allResults = [];
      showLoading();
    }

    try {
      const data = await fetchParking(query, currentFilter, currentPage);

      totalCount = data.totalCount;

      // 위경도가 없는 항목 제거
      const validItems = data.items.filter(function(lot) {
        return lot.lat && lot.lng;
      });

      if (isLoadMore) {
        allResults = allResults.concat(validItems);
      } else {
        allResults = validItems;
      }

      hideLoading();
      renderResults(allResults);

      // 지도 중심 이동
      const center = regionCenters[query];
      if (!mapInitialized) {
        initMap(center ? center.lat : 37.5665, center ? center.lng : 126.9780);
      } else if (map && center && !isLoadMore) {
        map.setCenter(new naver.maps.LatLng(center.lat, center.lng));
      }

      addMarkers(allResults);

      // 더보기 버튼 표시 여부
      const loadedCount = currentPage * 50;
      if (loadedCount < totalCount && data.items.length > 0) {
        loadMoreWrapper.classList.remove('hidden');
      } else {
        loadMoreWrapper.classList.add('hidden');
      }
    } catch (err) {
      showError(err.message || '주차장 정보를 불러올 수 없습니다.');
    }
  }

  // 결과 렌더링
  function renderResults(results) {
    if (results.length > 0) {
      resultsSection.classList.remove('hidden');
      emptyState.classList.add('hidden');
      errorState.classList.add('hidden');
      resultsCount.textContent = results.length;
      totalCountEl.textContent = totalCount > results.length ? '(전체 ' + totalCount + '건)' : '';

      resultsList.innerHTML = results.map(function(lot, i) {
        return '\
        <div class="parking-card p-5 border border-gray-200 rounded-2xl hover:border-emerald-200 hover:shadow-md transition-all cursor-pointer" data-index="' + i + '">\
          <div class="flex items-start justify-between gap-4">\
            <div class="flex-1 min-w-0">\
              <div class="flex items-center gap-2 mb-1.5">\
                <h3 class="font-bold text-gray-900 text-lg truncate">' + lot.name + '</h3>\
                <span class="shrink-0 px-2 py-0.5 text-xs font-semibold rounded-md ' + (lot.isFree ? 'bg-emerald-50 text-emerald-600' : 'bg-blue-50 text-blue-600') + '">\
                  ' + (lot.isFree ? '무료' : '유료') + '\
                </span>\
                <span class="shrink-0 px-2 py-0.5 text-xs font-medium rounded-md bg-gray-100 text-gray-500">\
                  ' + lot.type + (lot.category ? ' / ' + lot.category : '') + '\
                </span>\
              </div>\
              <p class="text-sm text-gray-500 mb-3">' + lot.address + '</p>\
              <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-gray-600">\
                <span class="flex items-center gap-1.5">\
                  <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>\
                  ' + (lot.weekdayOpen || '-') + '~' + (lot.weekdayClose || '-') + '\
                </span>\
                ' + (lot.totalSpaces ? '<span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>주차면 ' + lot.totalSpaces + '면</span>' : '') + '\
                ' + (lot.feeInfo ? '<span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>' + lot.feeInfo + '</span>' : '') + '\
                ' + (lot.phone ? '<span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>' + lot.phone + '</span>' : '') + '\
              </div>\
            </div>\
          </div>\
        </div>';
      }).join('');

      // 카드 클릭 시 지도 이동 + InfoWindow 표시
      document.querySelectorAll('.parking-card').forEach(function(card) {
        card.addEventListener('click', function() {
          var idx = parseInt(card.getAttribute('data-index'));
          if (markers[idx] && map) {
            var lot = results[idx];
            map.setCenter(new naver.maps.LatLng(lot.lat, lot.lng));
            map.setZoom(16);
            infoWindows.forEach(function(iw) { iw.close(); });
            if (infoWindows[idx]) infoWindows[idx].open(map, markers[idx]);
          }
        });
      });
    } else {
      resultsSection.classList.remove('hidden');
      emptyState.classList.add('hidden');
      resultsCount.textContent = '0';
      totalCountEl.textContent = '';
      loadMoreWrapper.classList.add('hidden');
      resultsList.innerHTML = '\
        <div class="text-center py-12">\
          <p class="text-gray-400 text-lg">검색 결과가 없습니다</p>\
          <p class="text-gray-300 text-sm mt-1">다른 지역명으로 검색해보세요</p>\
        </div>\
      ';
    }
  }

  // 이벤트 리스너
  searchBtn.addEventListener('click', function() { performSearch(false); });
  searchInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') performSearch(false);
  });

  // 더보기 버튼
  loadMoreBtn.addEventListener('click', function() {
    currentPage++;
    performSearch(true);
  });

  // 필터 탭 클릭
  filterTabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      filterTabs.forEach(function(t) {
        t.classList.remove('bg-emerald-600', 'text-white');
        t.classList.add('bg-gray-100', 'text-gray-600');
      });
      tab.classList.remove('bg-gray-100', 'text-gray-600');
      tab.classList.add('bg-emerald-600', 'text-white');

      currentFilter = tab.getAttribute('data-filter');

      if (searchInput.value.trim()) {
        performSearch(false);
      }
    });
  });

  // 빠른 검색 태그 클릭
  quickSearchTags.forEach(function(tag) {
    tag.addEventListener('click', function() {
      searchInput.value = tag.getAttribute('data-region');
      performSearch(false);
    });
  });
</script>
