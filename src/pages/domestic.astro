---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import TripCard from '../components/TripCard.astro';
import { getTripsByCategory } from '../utils/trips';

const trips = getTripsByCategory('domestic');
---

<BaseLayout
  title="국내여행 가이드 | 더트립가이드"
  description="국내여행 준비물, 코스 추천, 꿀팁을 총정리한 가이드입니다."
>
  <Header />
  <div class="max-w-2xl mx-auto">
    <div class="flex flex-col gap-8">
      {trips.length === 0 ? (
        <p>아직 국내여행 콘텐츠가 없습니다.</p>
      ) : (
        trips.map((trip) => (
          <TripCard
            title={trip.title}
            date={trip.date}
            excerpt={trip.excerpt}
            slug={trip.slug}
            lightColor={trip.lightColor}
            darkColor={trip.darkColor}
          />
        ))
      )}
    </div>
  </div>
</BaseLayout>
